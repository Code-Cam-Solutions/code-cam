DATABASE_URL=postgresql://user:password@localhost:5432/codecam?schema=public
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# ─── Fornecedor de IA ───────────────────────────────────────────────────────
#
# Qual serviço analisa as fotos: `nvidia` (padrão) ou `gemini`.
# Trocar é editar esta linha — o app fala com os dois pela mesma interface.
AI_PROVIDER=nvidia

# NVIDIA — chave gratuita em https://build.nvidia.com (começa com "nvapi-").
# Sem ela, o scan devolve conteúdo de demonstração e o app segue percorrível.
NVIDIA_API_KEY=

# Modelo da análise. O padrão está no código.
#
# O catálogo em /v1/models lista o que existe, não o que a sua chave alcança:
# vários modelos de lá respondem 404. Os que foram medidos com uma foto de
# lousa: moonshotai/kimi-k3 transcreveu o texto inteiro sem erro (18s a 38s,
# a latência varia bastante); meta/llama-3.2-11b-vision-instruct leva ~39s e
# obedece mal à instrução de quantidade de flashcards.
# NVIDIA_MODEL=moonshotai/kimi-k3

# Google Gemini — usado quando AI_PROVIDER=gemini.
GEMINI_API_KEY=

# Modelo do Gemini. Existe porque o Google aposenta modelos sem aviso: o
# gemini-1.5-flash que ficava fixo no código passou a responder 404 e derrubou
# toda captura de foto.
# GEMINI_MODEL=gemini-3.5-flash

PORT=3000
FRONTEND_URL=http://localhost:5173
