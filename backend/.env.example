DATABASE_URL=postgresql://user:password@localhost:5432/codecam?schema=public
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Chave do Google AI Studio. Sem ela o scan devolve conteúdo de demonstração,
# o que mantém o app percorrível de ponta a ponta sem gastar cota.
GEMINI_API_KEY=your-gemini-api-key-here

# Modelo usado na análise das fotos. Opcional — o padrão está no código.
#
# Existe porque o Google aposenta modelos sem aviso: o gemini-1.5-flash que
# ficava fixo no código passou a responder 404 e derrubou toda captura de foto.
# Se a análise começar a falhar com "fora do ar", confira a lista atual em
# https://ai.google.dev/gemini-api/docs/models e ajuste aqui.
# GEMINI_MODEL=gemini-3.5-flash

PORT=3000
FRONTEND_URL=http://localhost:5173

# Banco de produção (Railway). Usado só pelos scripts de promoção — o app
# sempre lê DATABASE_URL. Manter separado evita apontar o desenvolvimento
# para produção por engano ao mexer em uma linha só.
#
#   npm run db:promote:check      diagnostica a conexão
#   npm run db:promote            aplica as migrações
#   npm run db:promote:with-data  migrações + cópia dos dados locais
DATABASE_URL_PRODUCTION=
