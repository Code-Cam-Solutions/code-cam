{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    /*
     * Compilação incremental desligada aqui de propósito.
     *
     * `nest build` apaga `dist/` antes de compilar (`deleteOutDir`), mas o
     * `.tsbuildinfo` sobrevive à limpeza. Na build seguinte o TypeScript lê
     * aquele arquivo, conclui que nada mudou e não emite nada — e o resultado é
     * um `dist/` vazio com um `npm start` que morre em "Cannot find module
     * dist/main". O ganho de segundos não paga esse modo de falha.
     */
    "incremental": false
  },
  "exclude": ["node_modules", "test", "dist", "**/*spec.ts"]
}
