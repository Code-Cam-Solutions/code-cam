{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "types": ["vite/client", "vitest/globals", "@testing-library/jest-dom"],
    "noEmit": true
  },
  // `exclude` é herdado de tsconfig.app.json, que exclui justamente os testes.
  "exclude": [],
  "include": ["src/test/**/*", "src/**/*.test.ts", "src/**/*.test.tsx", "src/vite-env.d.ts"]
}
